{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ar-yosegaki-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-16",
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "ar-yosegaki-private" }],
  "vars": {
    "ALLOWED_ORIGIN": "https://YOUR-USERNAME.github.io"
  }
}
